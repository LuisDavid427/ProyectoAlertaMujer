<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <include
        android:id="@+id/btn_back"
        layout="@layout/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="9dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_titulo_recuperar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recuperar contraseña"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="60dp" />

    <TextView
        android:id="@+id/tv_subtitulo_recuperar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ingresa tu correo electrónico registrado y te enviaremos un codigo para restablecer tu contraseña."
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo_recuperar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_email_recuperacion"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="Correo electrónico"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitulo_recuperar">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_email_recuperacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_enviar_recuperacion"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:text="Enviar"
        app:backgroundTint="#E91E63"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/til_email_recuperacion" />

</androidx.constraintlayout.widget.ConstraintLayout>