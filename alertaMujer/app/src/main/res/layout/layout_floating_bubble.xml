<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_bubble_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- BOTONES SECUNDARIOS (Opciones desplegables) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_opcion_calls"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:backgroundTint="#0288D1"
        app:cornerRadius="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_opcion_audio"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:backgroundTint="#388E3C"
        app:cornerRadius="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_opcion_foto"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:backgroundTint="#F57C00"
        app:cornerRadius="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_opcion_video"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:backgroundTint="#7B1FA2"
        app:cornerRadius="24dp" />

    <!-- BOTÓN PRINCIPAL DE LA BURBUJA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_center"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_gravity="center"
        android:text="SOS"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#D32F2F"
        app:cornerRadius="33dp"
        app:elevation="8dp" />

</FrameLayout>