  +guardarEvidencia(idAlerta: Integer, archivo: MultipartFile, tipo: String, correosNotificar: List<String>): void
}

class AuthService {
  -usuarioService: UsuarioService
  -passwordEncoder: PasswordEncoder
  -jwtUtil: JwtUtil
  -emailService: EmailService
  -usuarioRepository: UsuarioRepository
  --
  +AuthService(usuarioService: UsuarioService, passwordEncoder: PasswordEncoder, jwtUtil: JwtUtil, emailService: EmailService, usuarioRepository: UsuarioRepository)
  +validarMovil(email: String, passwordPlano: String): Map<String,Object>
  +autenticarAdmin(email: String, passwordPlano: String): String
  +procesarRecuperacionPassword(email: String): boolean
  +actualizarPasswordConCodigo(email: String, codigo: String, nuevaPassword: String): boolean
  +verificarCodigoRecuperacion(email: String, codigo: String): boolean
  -tieneRolAdmin(usuario: UsuarioModel): boolean
  -obtenerRolPrincipal(usuario: UsuarioModel): String
}

class DashboardService {
  -usuarioRepo: UsuarioRepository
  -alertaRepo: AlertaRepository
