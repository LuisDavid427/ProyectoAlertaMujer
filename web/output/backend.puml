  +listarAlertas(busqueda: String): List<AlertaDashboardDTO>
  -obtenerInteger(fila: Object[], index: int): Integer
  -obtenerString(fila: Object[], index: int): String
  -obtenerBoolean(fila: Object[], index: int): boolean
  -convertirFecha(valor: Object): LocalDateTime
  -convertirBigDecimal(valor: Object): BigDecimal
}

class EmailService {
  -mailSender: JavaMailSender
  --
  +enviarCorreoCodigo(paraDestino: String, codigo: String): void
}

class FcmService {
  -{static} LLAVE_SECRETA: String = "AlertaMujerSuperSecretKey2026!!!"
  --
