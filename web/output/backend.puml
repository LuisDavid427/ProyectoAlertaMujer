  +actualizarEstado(id: Integer, nuevoEstado: boolean): void
}

class AesUtil {
  -{static} ALGORITMO: String = "AES/GCM/NoPadding"
  -{static} TAMAÑO_IV: int = 12
  -{static} TAMAÑO_TAG: int = 128
